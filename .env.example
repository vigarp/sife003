# Turso Cloud Database (libSQL / SQLite)
# Dapatkan dari Turso CLI (turso db show <db-name> --url) atau console.turso.tech
# Jika dikosongkan pada local dev, otomatis fallback ke SQLite file lokal di data/agenda.db
TURSO_DATABASE_URL="libsql://your-database-name-organization.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# JWT Secret for Admin Session Token
JWT_SECRET="ganti-dengan-string-rahasia-acak-di-produksi"

# Cloudflare Turnstile (Bot Protection untuk Login)
# Dapatkan gratis dari Cloudflare Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Kosongkan jika belum ingin mengaktifkan Turnstile (opsional)
# Untuk testing lokal / development, dapat gunakan test keys resmi Cloudflare:
# Site Key test (Always Pass): 1x00000000000000000000AA
# Secret Key test (Always Pass): 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
